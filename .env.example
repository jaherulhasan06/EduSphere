# Supabase Configuration (Frontend / Public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application Mode & AI Provider
# When VITE_SUPABASE_URL is not configured, the platform runs in clearly labelled Demo Mode
# with full server-backed API persistence and WebSocket multiplayer rooms.
VITE_DEMO_MODE=true
VITE_AI_PROVIDER=mock

# Server-Side Secrets (Never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
